---
import Base from '../layouts/Base.astro';
import { CATEGORIES, GROUPS, LANGS, templates, url } from '../lib/data';
const count = (c: string) => templates.filter((t) => t.category === c).length;
const first = templates[0];
---
<Base title="Templates Hub · Biblioteca de componentes" description="Componentes de interfaz con vista previa en vivo, código en HTML, Tailwind, React y Vue, y el prompt para generarlos con IA.">
  <section class="hero">
    <div>
      <h1>Componentes de interfaz listos para copiar</h1>
      <p class="lead">{templates.length} componentes con vista previa en vivo, código en {Object.values(LANGS).map((l) => l.label).slice(0, 4).join(', ')} y el prompt para pedirlos a tu IA. Gratis.</p>
      <div class="actions">
        <a class="btn primary" href={url('/t/button-variants/')}>Ver un componente</a>
        <a class="btn" href={url('/c/paleta-de-color/')}>Empezar por el color</a>
      </div>
    </div>
    <div class="canvas">
      <div class="stage">
        <div class="frame"><iframe data-preview src={url('/preview/stat-cards.html')} title="Ejemplo: tarjetas de métricas" sandbox="allow-scripts"></iframe></div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="catalogo">
    <h2 id="catalogo">Catálogo</h2>
    <div class="groups">
      {GROUPS.map((g) => (
        <div class="group">
          <h3>{g.label}</h3>
          <p>{g.blurb}</p>
          <ul>
            {g.cats.map((c) => (
              <li><a href={url(`/c/${c}/`)}>{CATEGORIES[c].label}<span>{count(c)}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
