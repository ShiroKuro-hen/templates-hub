---
import { Code } from 'astro:components';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, LANGS, groupOf, ordered, templates, url } from '../../lib/data';
import { THEMES } from '../../lib/themes';
export const getStaticPaths = () => templates.map((t) => ({ params: { slug: t.slug }, props: { t } }));
const { t } = Astro.props;
const langs = Object.keys(t.code).filter((l) => LANGS[l]);
const cat = CATEGORIES[t.category];
const group = groupOf(t.category);
const i = ordered.findIndex((x) => x.slug === t.slug);
const prev = ordered[i - 1];
const next = ordered[i + 1];
// {{variable}} del prompt resaltada.
const parts = t.prompt.split(/(\{\{[^}]+\}\})/);
const preview = url(`/preview/${t.slug}.html`);
---
<Base title={`${t.title} · Templates Hub`} description={t.description} current={t.slug}>
  <nav class="crumbs" aria-label="Ruta">
    <a href={url('/')}>Inicio</a><span aria-hidden="true">/</span>
    <span>{group.label}</span><span aria-hidden="true">/</span>
    <a href={url(`/c/${t.category}/`)}>{cat.label}</a>
  </nav>
  <h1>{t.title}</h1>
  <p class="lead">{t.description}</p>
  <div class="pills">
    {langs.map((l) => <span class="pill lang">{LANGS[l].label}</span>)}
    {t.tags.map((x) => <span class="pill">{x}</span>)}
  </div>

  {t.code.html && (
    <section class="sec" id="ejemplo">
      <h2>Ejemplo</h2>
      <p>Interactivo. Cambia el ancho para probar la respuesta; el tema sigue al del sitio.</p>
      <div class="canvas" id="canvas">
        <div class="bar">
          <div class="seg" role="group" aria-label="Ancho de la vista previa">
            <button type="button" data-w="375" aria-pressed="false">Móvil</button>
            <button type="button" data-w="768" aria-pressed="false">Tablet</button>
            <button type="button" data-w="" aria-pressed="true">Completo</button>
          </div>
          <label>Estilo
            <select id="style-select">
              {THEMES.map((s) => <option value={s.id}>{s.label}</option>)}
            </select>
          </label>
          <a class="btn" href={preview} target="_blank" rel="noopener">Abrir en pestaña</a>
          <output class="ruler" id="ruler">—</output>
        </div>
        <details class="custom">
          <summary>Personalizar</summary>
          <div class="fields">
            <label>Acento <input type="color" id="c-accent"></label>
            <label>Radio <input type="range" min="0" max="32" id="c-radius"> <output>8px</output></label>
            <label>Sombra
              <select id="c-shadow">
                <option value="">Del estilo</option>
                <option value="none">Ninguna</option>
                <option value="soft">Suave</option>
                <option value="hard">Dura</option>
              </select>
            </label>
            <label>Fuente
              <select id="c-font">
                <option value="">Del estilo</option>
                <option value="system">Sistema</option>
                <option value="serif">Serif</option>
                <option value="mono">Mono</option>
              </select>
            </label>
            <button class="btn" type="button" id="reset-custom">Restablecer</button>
            <button class="btn" type="button" id="copy-link">Copiar enlace</button>
          </div>
        </details>
        <div class="stage">
          <div class="frame" id="frame">
            <iframe data-preview src={preview} title={`Vista previa de ${t.title}`} sandbox="allow-scripts allow-popups" allow="clipboard-write" loading="lazy"></iframe>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="sec" id="prompt">
    <h2>Prompt</h2>
    <p>Pídele este componente a tu IA. Reemplaza lo que va entre llaves dobles.</p>
    <div class="prompt">
      <div class="bar"><span class="pill">Español</span><button class="btn primary" type="button" data-copy={t.prompt} data-with-style>Copiar prompt</button></div>
      <pre>{parts.map((p) => (p.startsWith('{{') ? <mark>{p}</mark> : p))}</pre>
    </div>
  </section>

  <section class="sec" id="codigo">
    <h2>Código</h2>
    <p>Elige tu lenguaje. Cada versión es independiente y no usa librerías.</p>
    <div class="codebox">
      <div class="tabs" role="tablist" aria-label="Lenguaje">
        {langs.map((l, n) => <button role="tab" id={`tab-${l}`} aria-controls={`panel-${l}`} aria-selected={n === 0} tabindex={n === 0 ? 0 : -1} data-tab={l}>{LANGS[l].label}</button>)}
        <button class="btn" type="button" id="copy-code">Copiar código</button>
      </div>
      {langs.map((l, n) => (
        <div role="tabpanel" id={`panel-${l}`} aria-labelledby={`tab-${l}`} data-panel={l} data-code={t.code[l]} hidden={n !== 0}>
          {l === 'tailwind' && <p class="note">Requiere la <a href={url('/tailwind/')}>configuración de Tailwind</a>.</p>}
          <div class="file">{l}.{LANGS[l].ext}</div>
          <Code code={t.code[l]} lang={LANGS[l].shiki as any} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
        </div>
      ))}
    </div>
  </section>

  <nav class="pn" aria-label="Componentes vecinos">
    {prev ? <a href={url(`/t/${prev.slug}/`)}><small>Anterior</small>{prev.title}</a> : <span></span>}
    {next ? <a href={url(`/t/${next.slug}/`)}><small>Siguiente</small>{next.title}</a> : <span></span>}
  </nav>
</Base>

<script>
  import { themeCss } from '../../lib/themes';
  import { applyTheme } from '../../lib/apply-theme';
  import { copy } from '../../lib/copy';
  import { currentTheme, readState, saveState } from '../../lib/hub-theme';
  import { toParams, type Overrides } from '../../lib/customize';
  import { stylePrompt } from '../../lib/style-prompt';

  const $ = <T extends Element>(s: string) => [...document.querySelectorAll<T>(s)];

  // Pestañas por lenguaje (flechas, Home/End) + recuerda la última elección.
  const tabs = $<HTMLElement>('[data-tab]');
  const show = (l: string) => {
    tabs.forEach((b) => { const on = b.dataset.tab === l; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; });
    $<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== l));
    try { localStorage.setItem('lang', l); } catch {}
  };
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => show(b.dataset.tab!));
    b.addEventListener('keydown', (e) => {
      const k = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (k === undefined) return;
      e.preventDefault();
      const t = tabs[(k + tabs.length) % tabs.length];
      t.focus(); show(t.dataset.tab!);
    });
  });
  try { const s = localStorage.getItem('lang'); if (s && tabs.some((b) => b.dataset.tab === s)) show(s); } catch {}

  document.getElementById('copy-code')?.addEventListener('click', (e) => {
    const panel = $<HTMLElement>('[data-panel]:not([hidden])')[0];
    copy(e.currentTarget as HTMLElement, applyTheme(panel.dataset.code!, currentTheme()));
  });
  const promptText = (b: HTMLElement) => b.dataset.copy! + (b.hasAttribute('data-with-style') ? stylePrompt(currentTheme()) : '');
  $<HTMLElement>('[data-copy]').forEach((b) => b.addEventListener('click', () => copy(b, promptText(b))));

  const styleSelect = document.getElementById('style-select') as HTMLSelectElement | null;
  if (styleSelect) {
    const accent = document.getElementById('c-accent') as HTMLInputElement;
    const radius = document.getElementById('c-radius') as HTMLInputElement;
    const radiusOut = document.querySelector<HTMLOutputElement>('.custom output')!;
    const shadow = document.getElementById('c-shadow') as HTMLSelectElement;
    const font = document.getElementById('c-font') as HTMLSelectElement;

    const sendStyle = (f: HTMLIFrameElement) => f.contentWindow?.postMessage({ css: themeCss(currentTheme()) }, '*');
    const syncStyle = () => $<HTMLIFrameElement>('iframe[data-preview]').forEach(sendStyle);

    const reflect = () => {
      const s = readState();
      styleSelect.value = s.styleId;
      const { light } = currentTheme(s);
      accent.value = /^#[0-9a-f]{6}$/i.test(light['--accent'] ?? '') ? light['--accent'] : '#2f5bff';
      radius.value = String(parseInt(light['--radius'] ?? '8', 10));
      radiusOut.value = `${radius.value}px`;
      shadow.value = s.overrides.shadow ?? '';
      font.value = s.overrides.font ?? '';
    };
    const edit = (change: (s: ReturnType<typeof readState>) => ReturnType<typeof readState>) => {
      const s = change(readState());
      saveState(s.styleId, s.overrides);
      history.replaceState(null, '', `${location.pathname}?${toParams(s.styleId, s.overrides)}`);
      syncStyle();
      reflect();
    };
    const setOverride = (key: keyof Overrides, value: unknown) =>
      edit((s) => ({ ...s, overrides: { ...s.overrides, [key]: value } as Overrides }));

    styleSelect.addEventListener('change', () => edit((s) => ({ ...s, styleId: styleSelect.value })));
    accent.addEventListener('input', () => setOverride('accent', accent.value));
    radius.addEventListener('input', () => setOverride('radius', Number(radius.value)));
    shadow.addEventListener('change', () => setOverride('shadow', shadow.value || undefined));
    font.addEventListener('change', () => setOverride('font', font.value || undefined));
    document.getElementById('reset-custom')!.addEventListener('click', () => edit((s) => ({ ...s, overrides: {} })));
    document.getElementById('copy-link')!.addEventListener('click', (e) => copy(e.currentTarget as HTMLElement, location.href));

    document.addEventListener('load', (e) => { if ((e.target as Element).matches?.('iframe[data-preview]')) sendStyle(e.target as HTMLIFrameElement); }, true);
    reflect();
    syncStyle();
  }

  // Lienzo: ancho predefinido + regla en vivo (el marco también se redimensiona a mano).
  const frame = document.getElementById('frame');
  if (frame) {
    const ruler = document.getElementById('ruler')!;
    new ResizeObserver(() => (ruler.textContent = `${Math.round(frame.clientWidth)} × ${Math.round(frame.clientHeight)} px`)).observe(frame);
    $<HTMLElement>('[data-w]').forEach((b) =>
      b.addEventListener('click', () => {
        frame.style.width = b.dataset.w ? `${b.dataset.w}px` : '';
        $<HTMLElement>('[data-w]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );
  }
</script>
