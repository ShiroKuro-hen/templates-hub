---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { CATEGORIES, GROUPS, groupOf, templates, url } from '../lib/data';

const { title = 'Templates Hub', description = 'Componentes de interfaz con vista previa, código en varios lenguajes y prompt para IA.', current = '' } = Astro.props;
const inCat = (c: string) => templates.filter((t) => t.category === c);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light'); } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <button class="iconbtn menu" id="menu" aria-label="Abrir navegación" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <a class="brand" href={url('/')}><span class="mark" aria-hidden="true"></span>Templates Hub</a>
      <span class="spacer"></span>
      <button class="toplink" id="open-palette" type="button" aria-haspopup="dialog"><span class="lbl">Buscar</span> <kbd id="kbd-hint">Ctrl K</kbd></button>
      <a class="toplink" href="https://github.com/ShiroKuro-hen/templates-hub" aria-label="GitHub">GitHub</a>
      <button class="iconbtn" id="theme" type="button" aria-label="Cambiar entre tema claro y oscuro">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </header>

    <dialog class="palette" id="palette" aria-label="Paleta de comandos">
      <div class="p-head">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="p-input" type="text" role="combobox" aria-expanded="true" aria-controls="p-list" aria-autocomplete="list" placeholder="Busca un componente o una acción" autocomplete="off" spellcheck="false" />
        <kbd>Esc</kbd>
      </div>
      <ul id="p-list" role="listbox" aria-label="Resultados"></ul>
      <p class="p-empty" id="p-empty" hidden>Sin resultados. Prueba con otra palabra, por ejemplo "tabla" o "modal".</p>
      <div class="p-foot"><span><kbd>↑</kbd> <kbd>↓</kbd> navegar</span><span><kbd>Enter</kbd> abrir</span></div>
    </dialog>
    <script type="application/json" id="p-index" set:html={JSON.stringify(
      templates.map((t) => ({ t: t.title, c: CATEGORIES[t.category].label, g: groupOf(t.category).label, d: t.description, q: `${t.title} ${t.description} ${CATEGORIES[t.category].label} ${groupOf(t.category).label} ${t.tags.join(' ')}`.toLowerCase(), u: url(`/t/${t.slug}/`) })),
    )} />
    <script type="application/json" id="p-cats" set:html={JSON.stringify(
      Object.entries(CATEGORIES).map(([id, c]) => ({ t: c.label, u: url(`/c/${id}/`) })),
    )} />

    <div class="shell">
      <nav class="side" aria-label="Componentes" id="side">
        <label class="sr" for="filter">Filtrar componentes</label>
        <input id="filter" type="search" placeholder="Filtrar componentes" autocomplete="off" />
        {GROUPS.map((g) => (
          <details open data-group>
            <summary>{g.label}</summary>
            {g.cats.map((c) => (
              <div data-cat>
                <a class="catlabel" href={url(`/c/${c}/`)}>{CATEGORIES[c].label}</a>
                <ul>
                  {inCat(c).map((t) => (
                    <li data-q={`${t.title} ${CATEGORIES[c].label} ${t.tags.join(' ')}`.toLowerCase()}>
                      <a href={url(`/t/${t.slug}/`)} aria-current={t.slug === current ? 'page' : undefined}>{t.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </details>
        ))}
        <p class="none" id="none" hidden>Ningún componente coincide.</p>
      </nav>

      <main class="main">
        <div class="doc">
          <slot />
          <footer class="foot">Gratis y de código abierto. Cada componente incluye vista previa, código y prompt.</footer>
        </div>
      </main>
    </div>
  </body>
</html>

<script>
  const root = document.documentElement;
  const $ = <T extends Element>(s: string) => [...document.querySelectorAll<T>(s)];

  // Tema: el sitio y todas las vistas previas (iframes) cambian juntos.
  const post = (f: HTMLIFrameElement) => f.contentWindow?.postMessage({ theme: root.dataset.theme }, '*');
  const syncFrames = () => $<HTMLIFrameElement>('iframe[data-preview]').forEach(post);
  document.addEventListener('load', (e) => { if ((e.target as Element).matches?.('iframe[data-preview]')) post(e.target as HTMLIFrameElement); }, true);
  document.getElementById('theme')!.addEventListener('click', () => {
    const t = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = t;
    try { localStorage.setItem('theme', t); } catch {}
    syncFrames();
  });
  syncFrames();

  // Filtro del sidebar.
  const filter = document.getElementById('filter') as HTMLInputElement;
  filter.addEventListener('input', () => {
    const words = filter.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    $<HTMLElement>('.side li').forEach((li) => {
      const ok = words.every((w) => li.dataset.q!.includes(w));
      li.hidden = !ok;
      if (ok) shown++;
    });
    $<HTMLElement>('.side [data-cat]').forEach((c) => (c.hidden = !c.querySelector('li:not([hidden])')));
    $<HTMLDetailsElement>('.side [data-group]').forEach((g) => (g.hidden = !g.querySelector('li:not([hidden])')));
    document.getElementById('none')!.hidden = shown > 0;
  });
  const here = document.querySelector<HTMLElement>('.side a[aria-current]');
  const side = document.getElementById('side')!;
  if (here) side.scrollTop = here.offsetTop - side.clientHeight / 2; // sin mover la página

  // Menú móvil y atajo "/".
  const setNav = (open: boolean) => {
    document.body.classList.toggle('nav-open', open);
    document.getElementById('menu')!.setAttribute('aria-expanded', String(open));
  };
  document.getElementById('menu')!.addEventListener('click', () => setNav(!document.body.classList.contains('nav-open')));
  document.querySelector('.main')!.addEventListener('click', () => setNav(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setNav(false); });

  // Paleta de comandos (Ctrl/⌘ K o "/"): componentes, categorías y acciones.
  type Item = { t: string; u?: string; c?: string; g?: string; d?: string; q?: string; run?: () => void };
  const comps: Item[] = JSON.parse(document.getElementById('p-index')!.textContent!);
  const cats: Item[] = JSON.parse(document.getElementById('p-cats')!.textContent!).map((x: Item) => ({ ...x, c: 'Categoría', q: x.t.toLowerCase() }));
  const home = document.querySelector<HTMLAnchorElement>('.brand')!.href;
  const acts: Item[] = [
    { t: 'Ir al inicio', c: 'Acción', q: 'inicio home', u: home },
    { t: 'Cambiar tema claro u oscuro', c: 'Acción', q: 'tema oscuro claro dark light', run: () => document.getElementById('theme')!.click() },
    { t: 'Abrir el repositorio en GitHub', c: 'Acción', q: 'github repositorio codigo', u: 'https://github.com/ShiroKuro-hen/templates-hub' },
  ];
  const all = [...comps, ...cats, ...acts];
  const dlg = document.getElementById('palette') as HTMLDialogElement;
  const pin = document.getElementById('p-input') as HTMLInputElement;
  const plist = document.getElementById('p-list')!;
  let shown: Item[] = [];
  let sel = 0;

  const score = (it: Item, words: string[]) => {
    const t = it.t.toLowerCase();
    let s = 0;
    for (const w of words) {
      if (t.startsWith(w)) s += 3; else if (t.includes(w)) s += 2; else if (it.q!.includes(w)) s += 1; else return -1;
    }
    return s;
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function render() {
    const words = pin.value.toLowerCase().split(/\s+/).filter(Boolean);
    shown = words.length
      ? all.map((it) => [it, score(it, words)] as const).filter(([, s]) => s >= 0).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([it]) => it)
      : [...comps.slice(0, 6), ...acts];
    sel = 0;
    plist.innerHTML = shown.map((it, i) =>
      `<li role="option" id="p-${i}" data-i="${i}" aria-selected="${i === 0}"><span>${esc(it.t)}${it.d ? `<small>${esc(it.d)}</small>` : ''}</span><em>${esc(it.g ? `${it.g} / ${it.c}` : it.c ?? '')}</em></li>`).join('');
    document.getElementById('p-empty')!.hidden = shown.length > 0;
    pin.setAttribute('aria-activedescendant', shown.length ? 'p-0' : '');
  }
  function move(n: number) {
    if (!shown.length) return;
    plist.children[sel]?.setAttribute('aria-selected', 'false');
    sel = (n + shown.length) % shown.length;
    const el = plist.children[sel] as HTMLElement;
    el.setAttribute('aria-selected', 'true');
    el.scrollIntoView({ block: 'nearest' });
    pin.setAttribute('aria-activedescendant', el.id);
  }
  function go(i: number) {
    const it = shown[i];
    if (!it) return;
    dlg.close();
    if (it.run) it.run(); else location.href = it.u!;
  }
  function openPalette() { pin.value = ''; render(); if (!dlg.open) dlg.showModal(); pin.focus(); }

  pin.addEventListener('input', render);
  pin.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(sel + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(sel - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); go(sel); }
  });
  plist.addEventListener('click', (e) => { const li = (e.target as Element).closest<HTMLElement>('li'); if (li) go(+li.dataset.i!); });
  plist.addEventListener('mousemove', (e) => { const li = (e.target as Element).closest<HTMLElement>('li'); if (li && +li.dataset.i! !== sel) move(+li.dataset.i!); });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  document.getElementById('open-palette')!.addEventListener('click', openPalette);
  if (/Mac|iPhone|iPad/.test(navigator.platform)) document.getElementById('kbd-hint')!.textContent = '⌘ K';
  document.addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((document.activeElement as HTMLElement)?.tagName);
    if (((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') || (e.key === '/' && !typing)) { e.preventDefault(); openPalette(); }
  });
</script>
